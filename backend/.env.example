# Copy to .env and adjust for your local setup.

# development | test | production
NODE_ENV=development

# Port the Fastify server listens on
PORT=4000

# PostgreSQL connection string; create the database and adjust credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acme_salary_dev"

# Allowed origin for CORS - the frontend's local dev URL
CORS_ORIGIN="http://localhost:3000"

# One HR Manager. Generate with: npm run auth:hash -- 'a-long-private-password'
HR_EMAIL="hr@acme.example"
HR_PASSWORD_HASH=""
