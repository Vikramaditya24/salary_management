# Copy to .env and adjust for your local setup.

# development | test | production
NODE_ENV=development

# Port the Fastify server listens on
PORT=4000

# PostgreSQL connection string. With docker-compose (see repo root), the
# default service/credentials/db name below already match.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acme_salary_dev"

# Allowed origin for CORS - the frontend's local dev URL
CORS_ORIGIN="http://localhost:3000"
